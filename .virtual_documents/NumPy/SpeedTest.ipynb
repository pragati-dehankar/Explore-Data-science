#NumPy vs. Python Lists




import numpy as np
import time

size=1_000_000
list1=list(range(size))
list2=list(range(size))

start=time.time()
res=[x+y for x,y in zip(list1,list2)]
end=time.time()
print("Python lists add time:",end-start)

arr1=np.array(list1)
arr2=np.array(list2)

strat=time.time()
res=arr1+arr2
end=time.time()

print("NumPy array addition time:", end - start)



# Creating NumPy Arrays
import numpy as np

arr1=np.array([1,2,3,4,5])
print(arr1)

arr2=np.array([[12,13,14,15],[16,17,18,19]])
print(arr2)

print("Type:",arr1)
